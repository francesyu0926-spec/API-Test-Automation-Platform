{
  "name": "api-test-automation-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron UI for file-backed API test platform",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack:stage": "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-platform-bundle.ps1",
    "pack:win": "npm run build && npm run pack:stage && electron-builder --win --config electron-builder.yml",
    "pack:stage:runtime": "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-full-runtime.ps1",
    "runtime:prepare-dev": "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-runtime-dev.ps1",
    "runtime:embed-wheels": "powershell -ExecutionPolicy Bypass -File ./scripts/embed-python-offline-wheels.ps1",
    "pack:stage:docs": "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-delivery-docs.ps1",
    "pack:win:full": "npm run build && npm run pack:stage && npm run pack:stage:runtime && npm run pack:stage:docs && electron-builder --win --config electron-builder.full.yml",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "electron:install": "powershell -ExecutionPolicy Bypass -File ./scripts/install-electron-win.ps1"
  },
  "dependencies": {
    "d3": "^7.9.2",
    "iconv-lite": "^0.6.3",
    "js-yaml": "^4.1.0",
    "react-window": "^1.8.10",
    "ws": "^8.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
